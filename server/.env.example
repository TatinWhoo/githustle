# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ── CORS & URLs ───────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000
# Public API base URL; must start with https:// in production
PUBLIC_API_URL=http://localhost:4000

# ── Database ──────────────────────────────────────────────────────────────────
# Primary app connection
DATABASE_URL=postgresql://githustle_user:changeme@localhost:5432/githustle_dev
# Optional admin connection (falls back to DATABASE_URL if empty)
ADMIN_DATABASE_URL=

# ── Redis ─────────────────────────────────────────────────────────────────────
# Use rediss:// scheme with password in production
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────────────────────────
# At least 32 characters; generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace_with_at_least_32_char_secret
JWT_PREVIOUS_ACCESS_SECRET=
JWT_PREVIOUS_SECRET_ROTATED_AT=
JWT_PREVIOUS_SECRET_GRACE_MINUTES=60
JWT_ISSUER=githustle
JWT_AUDIENCE=githustle-api
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=7

# ── Auth Provider ─────────────────────────────────────────────────────────────
# 'local' (bcrypt+JWT) or 'clerk' (future)
AUTH_PROVIDER=local

# ── Password Hashing ──────────────────────────────────────────────────────────
# Must be >= 12 in production
BCRYPT_SALT_ROUNDS=12

# ── Account Lockout ───────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Wall-clock budget (ms) for timing-safe login path
LOGIN_TIMING_BUDGET_MS=200

# ── Email Verification ────────────────────────────────────────────────────────
EMAIL_VERIFY_EXPIRES_HOURS=24

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_placeholder
RESEND_FROM=GitHustle <no-reply@githustle.com>
EMAIL_FROM=GitHustle <no-reply@githustle.com>

# ── AI (Anthropic Claude) ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-placeholder
AI_MONTHLY_QUOTA=5

# ── reCAPTCHA ─────────────────────────────────────────────────────────────────
RECAPTCHA_SECRET_KEY=

# ── File Uploads ──────────────────────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
PORTFOLIO_IMAGE_MAX_SIZE_MB=8

# ── Sentry ────────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# 'redis' in production, 'memory' in development
RATE_LIMIT_STORE=redis

# ── Database Pool ─────────────────────────────────────────────────────────────
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
DB_IDLE_TX_TIMEOUT_MS=10000

# ── Proxy ─────────────────────────────────────────────────────────────────────
# Number of trusted reverse proxies (1 for nginx, range 1-5)
TRUSTED_PROXY_DEPTH=1
